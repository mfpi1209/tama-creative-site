{
  "name": "TaMa · Propostas 2/3: avisar o responsável (com nova tentativa)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
