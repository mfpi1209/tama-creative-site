      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normaliza e valida o pedido. Não confia no navegador: limita tamanhos e confere os obrigatórios.\nconst b = $json.body || {};\nconst h = $json.headers || {};\n// Campos de uma linha não aceitam quebra de linha (evita linhas falsas no e-mail, como \"Contato: ...\").\nconst t = (k, n, varias) => { let s = String(b[k] ?? '').replace(/\\u0000/g, ''); if (!varias) s = s.replace(/[\\r\\n\\t\\u2028\\u2029]+/g, ' '); return s.trim().slice(0, n); };\nconst viaSite = String(h['x-tama-envio'] || '') === 'fetch';\nlet pedidoId = t('pedido_id', 64);\n// Envio sem JavaScript (sem identificador): o servidor cria um.\nif (!pedidoId && !viaSite) pedidoId = 'sjs-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);\nconst pedido = {\n  pedido_id: pedidoId,\n  recebido_em: new Date().toISOString(),\n  status: 'novo',\n  nome: t('nome', 120), empresa: t('empresa', 160), contato: t('contato', 160),\n  tipo: t('tipo', 40), interesse: t('interesse', 160), selecao: t('selecao', 2000),\n  quantidade: t('quantidade', 20), data_desejada: t('data', 20), orcamento: t('orcamento', 60),\n  objetivo: t('objetivo', 4000, true), consentimento: t('consentimento', 10),\n  origem_pagina: t('origem_pagina', 200), primeira_pagina: t('primeira_pagina', 200), referencia: t('referencia', 200),\n  utm_source: t('utm_source', 100), utm_medium: t('utm_medium', 100), utm_campaign: t('utm_campaign', 100),\n  utm_term: t('utm_term', 100), utm_content: t('utm_content', 100),\n  notificacao: 'pendente', tentativas_aviso: 0, erro_aviso: '', avisado_em: '',\n};\nconst tipos = ['brindes', 'kits', 'confeccoes', 'ativacoes', 'hotelaria', 'integrado'];\nconst erros = [];\nif (!/^(sjs-[a-z0-9-]{6,40}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i.test(pedido.pedido_id)) erros.push('pedido_id');\nif (pedido.nome.length < 2) erros.push('nome');\nconst digitos = pedido.contato.replace(/\\D/g, '');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(pedido.contato) && digitos.length < 10) erros.push('contato');\nif (!tipos.includes(pedido.tipo)) erros.push('tipo');\nif (pedido.objetivo.length < 10) erros.push('objetivo');\nif (pedido.consentimento !== 'sim') erros.push('consentimento');\nreturn { json: { spam: t('bot-field', 200) !== '', valido: erros.length === 0, erros, pedido } };"
      },
